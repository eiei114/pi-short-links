{
  "name": "pi-short-links",
  "version": "0.1.0",
  "description": "Shorten long URLs and file paths in Pi assistant output so OSC 8 / click targets fit the pane width.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "osc8",
    "hyperlink",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-short-links.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-short-links/issues"
  },
  "homepage": "https://github.com/eiei114/pi-short-links#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/shorten.test.mjs",
    "pack:check": "npm pack --dry-run",
    "ci": "npm run typecheck && npm test && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions/short-links.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
